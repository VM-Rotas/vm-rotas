generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  DISPATCHER
  DRIVER
  VIEWER
}

enum VehicleStatus {
  AVAILABLE
  IN_ROUTE
  MAINTENANCE
  INACTIVE
}

enum ServiceOrderType {
  DELIVERY
  PICKUP
}

enum ServiceOrderStatus {
  PLANNED
  READY
  ROUTED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum OrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RouteStatus {
  DRAFT
  OPTIMIZED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  SUPERSEDED
}

enum RouteStopType {
  DEPOT_START
  SERVICE
  DEPOT_END
}

enum RouteStopStatus {
  PENDING
  EN_ROUTE
  ARRIVED
  COMPLETED
  FAILED
  SKIPPED
}

enum OptimizationProvider {
  LOCAL
  GOOGLE
}

enum OptimizationStatus {
  PENDING
  SUCCESS
  FAILED
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  depots           Depot[]
  vehicles         Vehicle[]
  customers        Customer[]
  serviceOrders    ServiceOrder[]
  routePlans       RoutePlan[]
  optimizationRuns OptimizationRun[]
  auditLogs        AuditLog[]
  trackingSessions TrackingSession[]
  trackingPoints   TrackingPoint[]
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  email          String   @unique
  passwordHash   String
  role           UserRole @default(DISPATCHER)
  active         Boolean  @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdOrders      ServiceOrder[]     @relation("OrdersCreatedBy")
  drivenRoutes       RoutePlan[]        @relation("RoutesDrivenBy")
  requestedRuns      OptimizationRun[]  @relation("OptimizationRequestedBy")
  auditLogs          AuditLog[]
  trackingSessions   TrackingSession[]
  trackingPoints     TrackingPoint[]

  @@index([organizationId, role])
}

model Depot {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  addressLine    String
  city           String
  state          String
  postalCode     String?
  latitude       Decimal  @db.Decimal(10, 7)
  longitude      Decimal  @db.Decimal(10, 7)
  isDefault      Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  routePlans   RoutePlan[]

  @@index([organizationId, isDefault, active])
}

model Vehicle {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @db.Uuid
  plate             String
  name              String
  status            VehicleStatus @default(AVAILABLE)
  capacityWeightKg Decimal?      @db.Decimal(12, 3)
  capacityVolumeM3 Decimal?      @db.Decimal(12, 4)
  startHour         String?       @db.VarChar(5)
  endHour           String?       @db.VarChar(5)
  active            Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  routePlans       RoutePlan[]
  trackingSessions TrackingSession[]
  trackingPoints   TrackingPoint[]

  @@unique([organizationId, plate])
  @@index([organizationId, status, active])
}

model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  document       String?
  phone          String?
  email          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceOrders ServiceOrder[]

  @@index([organizationId, name])
  @@index([organizationId, document])
}

model ServiceOrder {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @db.Uuid
  customerId         String?            @db.Uuid
  createdById        String?            @db.Uuid
  code               String
  externalReference  String?
  type               ServiceOrderType
  status             ServiceOrderStatus @default(PLANNED)
  priority           OrderPriority      @default(NORMAL)
  plannedDate        DateTime           @db.Date
  timeWindowStart    DateTime?
  timeWindowEnd      DateTime?
  serviceDurationMin Int                @default(10)
  weightKg           Decimal?           @db.Decimal(12, 3)
  volumeM3           Decimal?           @db.Decimal(12, 4)
  recipientName      String
  recipientPhone     String?
  addressLine        String
  addressNumber      String?
  addressComplement  String?
  neighborhood       String?
  city               String
  state              String
  postalCode         String?
  formattedAddress   String?
  latitude           Decimal?           @db.Decimal(10, 7)
  longitude          Decimal?           @db.Decimal(10, 7)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("OrdersCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  routeStops   RouteStop[]

  @@unique([organizationId, code])
  @@index([organizationId, plannedDate, status])
  @@index([organizationId, priority, status])
  @@index([customerId])
}

model RoutePlan {
  id                   String               @id @default(uuid()) @db.Uuid
  organizationId       String               @db.Uuid
  depotId              String               @db.Uuid
  vehicleId            String               @db.Uuid
  driverId             String?              @db.Uuid
  routeDate            DateTime             @db.Date
  status               RouteStatus          @default(DRAFT)
  provider             OptimizationProvider @default(LOCAL)
  revision             Int                  @default(1)
  totalDistanceMeters  Int                  @default(0)
  totalDurationSeconds Int                  @default(0)
  encodedPolyline      String?
  startedAt            DateTime?
  finishedAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  depot            Depot             @relation(fields: [depotId], references: [id], onDelete: Restrict)
  vehicle          Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver           User?             @relation("RoutesDrivenBy", fields: [driverId], references: [id], onDelete: SetNull)
  stops            RouteStop[]
  optimizationRuns OptimizationRun[]

  @@unique([organizationId, routeDate, vehicleId, revision])
  @@index([organizationId, routeDate, status])
  @@index([vehicleId, routeDate])
}

model RouteStop {
  id                       String          @id @default(uuid()) @db.Uuid
  routePlanId              String          @db.Uuid
  serviceOrderId           String?         @db.Uuid
  type                     RouteStopType
  sequence                 Int
  status                   RouteStopStatus @default(PENDING)
  label                    String
  address                  String
  latitude                 Decimal         @db.Decimal(10, 7)
  longitude                Decimal         @db.Decimal(10, 7)
  plannedArrivalAt         DateTime?
  plannedDepartureAt       DateTime?
  actualArrivalAt          DateTime?
  actualDepartureAt        DateTime?
  distanceFromPreviousM    Int             @default(0)
  durationFromPreviousSec  Int             @default(0)
  notes                    String?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  routePlan    RoutePlan     @relation(fields: [routePlanId], references: [id], onDelete: Cascade)
  serviceOrder ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)

  @@unique([routePlanId, sequence])
  @@index([serviceOrderId])
  @@index([routePlanId, status])
}

model OptimizationRun {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  routePlanId    String?              @db.Uuid
  requestedById  String?              @db.Uuid
  provider       OptimizationProvider
  status         OptimizationStatus   @default(PENDING)
  requestPayload Json?
  responsePayload Json?
  errorMessage   String?
  startedAt      DateTime             @default(now())
  completedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  routePlan    RoutePlan?   @relation(fields: [routePlanId], references: [id], onDelete: SetNull)
  requestedBy  User?        @relation("OptimizationRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([organizationId, startedAt])
  @@index([routePlanId])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String?  @db.Uuid
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
}


model TrackingSession {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  userId             String   @db.Uuid
  vehicleId          String   @db.Uuid
  deviceId           String?
  deviceName         String?
  active             Boolean  @default(true)
  startedAt          DateTime @default(now())
  endedAt            DateTime?
  lastLatitude       Decimal? @db.Decimal(10, 7)
  lastLongitude      Decimal? @db.Decimal(10, 7)
  lastAccuracyM      Float?
  lastSpeedKmh       Float?
  lastHeading        Float?
  lastBatteryPercent Int?
  lastRecordedAt     DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle      Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  points       TrackingPoint[]

  @@index([organizationId, active])
  @@index([vehicleId, startedAt])
  @@index([userId, startedAt])
}

model TrackingPoint {
  id             BigInt   @id @default(autoincrement())
  organizationId String   @db.Uuid
  sessionId      String   @db.Uuid
  userId         String   @db.Uuid
  vehicleId      String   @db.Uuid
  latitude       Decimal  @db.Decimal(10, 7)
  longitude      Decimal  @db.Decimal(10, 7)
  accuracyM      Float?
  speedKmh       Float?
  heading        Float?
  batteryPercent Int?
  recordedAt     DateTime
  receivedAt     DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session      TrackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle      Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([sessionId, recordedAt])
  @@index([organizationId, recordedAt])
  @@index([vehicleId, recordedAt])
}
