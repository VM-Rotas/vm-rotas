{
  "name": "@vm-rotas/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "prebuild": "prisma generate",
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.spec.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name update",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "^11.2.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.2",
    "google-auth-library": "^10.3.0",
    "helmet": "^8.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.15.5",
    "prisma": "7.9.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
