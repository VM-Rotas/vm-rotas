# Banco local usado pelo Docker Compose
POSTGRES_DB=vm_rotas
POSTGRES_USER=vm_rotas
POSTGRES_PASSWORD=vm_rotas_dev

# API
DATABASE_URL=postgresql://vm_rotas:vm_rotas_dev@localhost:5432/vm_rotas?schema=public
JWT_SECRET=troque-por-uma-chave-com-no-minimo-32-caracteres
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SWAGGER_ENABLED=true
DEFAULT_TIME_ZONE=America/Sao_Paulo
ROUTE_OPTIMIZATION_PROVIDER=local
LOCAL_AVG_SPEED_KMH=35
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_ROUTE_OPTIMIZATION_ENABLED=false

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
